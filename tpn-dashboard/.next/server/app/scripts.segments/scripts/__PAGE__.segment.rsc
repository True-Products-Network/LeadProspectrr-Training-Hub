0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"style":{"maxWidth":"800px","margin":"0 auto","padding":"20px"},"children":[["$","a",null,{"href":"/","style":{"color":"#2563eb","textDecoration":"none"},"children":"← Back to Dashboard"}],["$","h1",null,{"style":{"marginTop":"20px"},"children":"Outreach Scripts"}],["$","p",null,{"style":{"color":"#666"},"children":"Cold call openers and follow-up sequences"}],["$","div",null,{"style":{"marginTop":"30px"},"children":[["$","h2",null,{"style":{"color":"#9333ea"},"children":"Cold Call Opener — ProspectFindrr Leads"}],["$","div",null,{"style":{"background":"#f3f4f6","padding":"20px","borderRadius":"8px","whiteSpace":"pre-wrap","lineHeight":"1.8"},"children":"\"Hi [Name], this is Nigel Lear with True Products Network.\n\nI was researching [industry] companies in [area] this morning and came across [Company Name]. I work with [their type of business] to fix a specific problem — scattered systems where leads fall through the cracks and follow-up never happens.\n\nQuick question: Are you guys still juggling multiple tools for booking, email, and keeping track of leads?\"\n\n[Let them respond]\n\n\"Yeah, that's exactly what I hear from everyone. Most businesses are paying for 4-5 different tools that don't talk to each other, and someone's spending hours every week just moving data around.\n\nI do something called a Digital Audit — takes 10 minutes, no cost, and I'll show you exactly where you're losing time and money and how to fix it.\n\nWorth a quick chat this week or next?\""}]]}],["$","div",null,{"style":{"marginTop":"30px"},"children":[["$","h2",null,{"style":{"color":"#9333ea"},"children":"Cold Call Opener — General"}],["$","div",null,{"style":{"background":"#f3f4f6","padding":"20px","borderRadius":"8px","whiteSpace":"pre-wrap","lineHeight":"1.8"},"children":"\"Hey [Name], this is Nigel Lear with True Products Network. \n\nI know I'm calling out of the blue, but I saw you're [role] at [company] and I work with [their type of business] to fix a problem you probably know well: leads falling through the cracks and follow-up that never happens.\n\nQuick question: Are you guys still juggling a bunch of different tools for booking, email, and CRM?\"\n\n[Let them respond]\n\n\"Yeah, that's exactly what I hear from everyone. Most businesses are paying for 4-5 tools that don't talk to each other. \n\nI do something called a Digital Audit — takes 10 minutes, no cost, and I'll show you exactly where you're losing time and money. \n\nWorth a quick chat this week or next?\""}]]}],["$","div",null,{"style":{"marginTop":"30px"},"children":[["$","h2",null,{"style":{"color":"#9333ea"},"children":"Follow-Up #1 (Next Day)"}],["$","div",null,{"style":{"background":"#f3f4f6","padding":"20px","borderRadius":"8px","whiteSpace":"pre-wrap","lineHeight":"1.8"},"children":"Subject: Quick follow-up\n\nHey [Name],\n\nQuick follow-up from yesterday. \n\nI know you're busy, but that Digital Audit really does only take 10 minutes and I've never had someone say \"I already knew all that\" after we do it.\n\nWorth 10 minutes to see where the leaks are?\n\nBook here: [CALENDAR LINK]\n\nOr just reply with a time that works.\n\nNigel"}]]}],["$","div",null,{"style":{"marginTop":"30px"},"children":[["$","h2",null,{"style":{"color":"#9333ea"},"children":"Follow-Up #2 (3 Days Later)"}],["$","div",null,{"style":{"background":"#f3f4f6","padding":"20px","borderRadius":"8px","whiteSpace":"pre-wrap","lineHeight":"1.8"},"children":"Subject: Last follow-up on the audit\n\nHey [Name],\n\nThis is my last follow-up on the Digital Audit — I don't want to be that guy who keeps emailing forever.\n\nHere's the deal: I only do 3 of these per week because they actually take real time to put together. \n\nIf you want one, grab a spot: [CALENDAR LINK]\n\nIf not, no worries. Just reply \"PASS\" and I'll close the loop.\n\nEither way, good luck with [company].\n\nNigel"}]]}],"$L2","$L3"]}],null,"$L4"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"V15P6oSYCyNpWR-_7nnaV"}
2:["$","div",null,{"style":{"marginTop":"30px"},"children":[["$","h2",null,{"style":{"color":"#9333ea"},"children":"Voicemail Script"}],["$","div",null,{"style":{"background":"#f3f4f6","padding":"20px","borderRadius":"8px","whiteSpace":"pre-wrap","lineHeight":"1.8"},"children":"\"Hey [Name], it's Nigel Lear with True Products Network. \n\nI'm calling because I work with [their type] to fix scattered systems and lead follow-up that falls through the cracks.\n\nWanted to offer you a free Digital Audit — takes 10 minutes, shows you exactly where you're losing time and money.\n\nGive me a call back at [YOUR NUMBER] or book a time at [CALENDAR LINK].\n\nThanks, [Name]. Talk soon.\""}]]}]
